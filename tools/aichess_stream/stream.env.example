# ~/.config/ai-chess/stream.env - settings for ai-chess-stream.service (see the header of stream.sh).
# The stream key is NOT here: it is in ~/.config/ai-chess/youtube-stream.env (mode 600, written by
# tools/aichess_stream/youtube_live.py install-key from the laptop).
AICHESS_STREAM_URL=http://127.0.0.1:8770/?stream=1
AICHESS_STREAM_SIZE=1920x1080
AICHESS_STREAM_FPS=30
AICHESS_STREAM_PRESET=veryfast
AICHESS_STREAM_VBITRATE=4500
AICHESS_STREAM_ABITRATE=128k
AICHESS_STREAM_DISPLAY=:87
AICHESS_CDP_PORT=9223
AICHESS_CHROME_MAX_MB=1400
# Music bed under the commentary (ducked). Remove the file or set AICHESS_STREAM_MUSIC= (empty) for none.
AICHESS_STREAM_MUSIC=__HOME__/.local/share/ai-chess-stream/music-bed.mp3
AICHESS_STREAM_MUSIC_GAIN=0.07
# rtmp = YouTube; null = encode and discard (CPU test); a path ending in .flv = record to a file
AICHESS_STREAM_OUTPUT=rtmp
AICHESS_STREAM_KEY_FILE=__HOME__/.config/ai-chess/youtube-stream.env
