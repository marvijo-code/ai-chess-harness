[Unit]
Description=AI chess Twitch gate (passes the stream on to Twitch only while the daily show is on)
Documentation=file://__HOME__/ai-chess/docs/aichess-stream.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__
RuntimeDirectory=ai-chess-twitch-gate
RuntimeDirectoryMode=0700
# the same file as the stream unit: AICHESS_TWITCH_GATE (the address) and AICHESS_TWITCH_KEY_FILE
EnvironmentFile=-__HOME__/.config/ai-chess/stream.env
ExecStart=/usr/bin/python3 -u __HOME__/.local/lib/ai-chess-stream/twitch_gate.py run
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
