[Unit]
Description=AI chess forever tournament runner (spawns claude/codex CLI moves, up to 3 games at once)
Documentation=file://__HOME__/ai-chess/docs/aichess-vps-forever.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=__HOME__/ai-chess/run-ai-chess-forever.sh
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__/ai-chess
Environment=PYTHONUNBUFFERED=1
Environment=PATH=__HOME__/.local/bin:__HOME__/bin:/opt/node-v24.18.0-linux-x64/bin:__HOME__/.bun/bin:/usr/local/bin:/usr/bin:/bin
# A stray base URL reroutes claude to a metered gateway; the runner uses the subscriptions.
UnsetEnvironment=ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY OPENAI_BASE_URL
Environment=AICHESS_RUNNER_ARGS=run-runner
EnvironmentFile=-__HOME__/.config/ai-chess/services.env
ExecStart=/bin/bash __HOME__/ai-chess/run-ai-chess-forever.sh $AICHESS_RUNNER_ARGS
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
