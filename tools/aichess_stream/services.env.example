# ~/.config/ai-chess/services.env - arguments for the AI-chess systemd units (read by runner, viewer, pusher).
# Edit, then: sudo systemctl restart ai-chess-<name>. Lines are KEY=value, no quotes needed.

# Viewer: run-ai-chess-forever.sh run-viewer (follow pointer, one 64 MB analysis engine, commentary on the codex sub).
# Override with AICHESS_ONE_ENGINE, AICHESS_ENGINE_HASH_MB, AI_CHESS_COMMENTARY, COMMENTARY_ROUTE.

# Pusher to the relay ingest on this machine (no ssh tunnel). Stop the laptop pusher first (run-aichess-push.ps1 -Stop).
AICHESS_PUSHER_ARGS=--local http://127.0.0.1:8770 --relay http://127.0.0.1:8781 --token-file __HOME__/acl-chess-relay/ingest.token --live-dir __HOME__/ai-chess/out/live

# Extra arguments for run-ai-chess-forever.sh (see docs/aichess-vps-forever.md).
AICHESS_RUNNER_ARGS=run-runner
